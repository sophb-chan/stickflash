{
	"name": "StickFlash IWA",
	"version": "0.0.0",
	"start_url": "/",
	"display": "standalone",
	"icons": [
		{
			"src": "icon.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	],
	"permissions": [
		"fileSystem",
		{
			"fileSystem": [
				"write",
				"retainEntries",
				"directory"
			]
		}
	],
	"isolated_web_app": {
		"permissions": [
			"isolated-storage"
		]
	}
}
